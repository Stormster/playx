# PlayX settings. ./setup.sh copies this to .env and fills in the first block.
# Never commit or share .env. Every setting is explained in docs/configuration.md.

# --- Basics ---------------------------------------------------------------
# Unlocks the admin page at /admin. Any long random string (setup.sh makes one).
XP_ADMIN_TOKEN=
# The user and group the game runs as; must own ./data. On Linux use `id -u` and `id -g`.
PUID=99
PGID=100

# --- Going public ---------------------------------------------------------
# The public address of the game page. Needed for the X card; blank = whatever host was used.
XP_ORIGIN=
# Cloudflare Tunnel token (docker compose --profile tunnel). See docs/deploy.md.
TUNNEL_TOKEN=

# --- Who runs this copy ---------------------------------------------------
# Your X account, credited on the card (with or without @).
XP_X_HANDLE=
# The small link on the handheld. Blank = "PlayX", linking to the project.
XP_FOOTER_TEXT=
XP_FOOTER_URL=

# --- Admin hardening (optional) -------------------------------------------
# Admin hostname(s) behind Cloudflare Access. When set, /admin answers only there.
XP_ADMIN_HOST=

# --- Video at scale (optional) --------------------------------------------
# Without these the game server sends video itself, which is fine for a small crowd.
# R2 video chunks: Cloudflare dashboard > R2 > your bucket, and R2 > Manage API tokens.
XP_R2_BUCKET=
XP_R2_ACCOUNT_ID=
XP_R2_ACCESS_KEY_ID=
XP_R2_SECRET_ACCESS_KEY=
XP_R2_PUBLIC_BASE=
# Live relay (relay/ folder, ~0.3 s video). XP_RELAY_SECRET must match the relay's PUB_SECRET.
XP_RELAY_URL=
XP_RELAY_SECRET=
